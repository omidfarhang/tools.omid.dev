APP_BASE_URL=https://tools.omid.dev
APP_NAME=Tools Center

# Host port published by docker compose (container always listens on 8080)
APP_PORT=8080

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Random secret for scripts/ytdl.sh and /dropbox.php (maps to APP_CLI_USERNAME)
APP_CLI_TOKEN=change-me-cli-token
APP_CLI_USERNAME=admin

# Docker defaults (override for bare-metal with absolute host paths)
DB_PATH=/var/www/html/storage/app.db
TEMP_DIR=/var/www/html/storage/temp
# Materialized cookie file for yt-dlp (content is managed in Admin → yt-dlp cookies)
YTDLP_COOKIES_PATH=/var/www/html/storage/ytdlp-cookies.txt
