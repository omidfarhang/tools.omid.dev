{
    "name": "omid/tools-omid-dev",
    "description": "Personal download-to-host tools with multi-user panels and Dropbox OAuth",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "bacon/bacon-qr-code": "^3",
        "robthree/twofactorauth": "^3.0",
        "symfony/clock": "^7.2",
        "symfony/property-access": "^7.2",
        "symfony/property-info": "^7.2",
        "symfony/serializer": "^7.2",
        "symfony/string": "^7.2",
        "symfony/type-info": "^7.2",
        "symfony/uid": "^7.2",
        "web-auth/webauthn-lib": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
