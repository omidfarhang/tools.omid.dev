# Host nginx terminates TLS and proxies to the Docker app on :8080.
# Adjust server_name and certificate paths.

upstream tools_omid_dev {
    # Match APP_PORT from .env / docker compose (default 8080)
    server 127.0.0.1:8080;
}

server {
    listen 443 ssl http2;
    server_name tools.omid.dev;

    ssl_certificate     /etc/letsencrypt/live/tools.omid.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tools.omid.dev/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://tools_omid_dev;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

server {
    listen 80;
    server_name tools.omid.dev;
    return 301 https://$host$request_uri;
}
